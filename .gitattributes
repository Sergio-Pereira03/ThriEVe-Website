# Normalize line endings across machines: store text as LF in the repo,
# and check it out as LF everywhere (keeps Windows + laptop consistent).
* text=auto eol=lf

# Binary assets — never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.ai   binary
*.woff  binary
*.woff2 binary
